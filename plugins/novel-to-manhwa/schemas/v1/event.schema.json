{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntm.dev/schemas/novel-to-manhwa/v1/event.schema.json",
  "title": "NTM sourced state transition event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "timeline", "type", "changes", "provenance"],
  "properties": {
    "schema_version": {"const": "ntm/event/v1"},
    "id": {"type": "string", "pattern": "^event_[a-z0-9_]+$"},
    "timeline": {"$ref": "#/$defs/timelinePosition"},
    "type": {"type": "string", "minLength": 1},
    "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "timelinePosition": {"type": "object", "additionalProperties": false, "required": ["date", "order", "scene_id"], "properties": {"date": {"type": "string", "format": "date"}, "order": {"type": "integer", "minimum": 0}, "scene_id": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["chapter_id", "locator"], "properties": {"chapter_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "excerpt": {"type": "string"}}},
    "change": {"type": "object", "additionalProperties": false, "required": ["entity_id", "state"], "properties": {"entity_id": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/statePatch"}}},
    "statePatch": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
      "physical_state": {"type": "object"}, "health_state": {"type": "object"}, "appearance_state": {"type": "object"}, "wardrobe_state": {"type": "object"}, "inventory_state": {"type": "object"}, "ownership_state": {"type": "object"}, "location_state": {"type": "object"}, "knowledge_state": {"type": "object"}, "ability_state": {"type": "object"}, "material_state": {"type": "object"}, "texture_state": {"type": "object"}, "energy_state": {"type": "object"}
    }}
  }
}
