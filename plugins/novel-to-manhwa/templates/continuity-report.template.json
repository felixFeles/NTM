{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity report",
  "type": "object",
  "required": ["chapter_id", "status", "findings", "checks"],
  "properties": {
    "chapter_id": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "blocked", "ready_for_review", "final"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"type": "string", "enum": ["pass", "fail", "not_run"]}, "detail": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "category", "message", "evidence", "disposition"], "properties": {"id": {"type": "string"}, "severity": {"type": "string", "enum": ["blocker", "error", "warning", "info"]}, "category": {"type": "string"}, "message": {"type": "string"}, "evidence": {"type": "array"}, "disposition": {"type": "string", "enum": ["open", "waived", "resolved"]}}}}
  }
}
