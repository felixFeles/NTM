{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical state-transition event",
  "type": "object",
  "required": ["id", "timeline_order", "chapter_id", "type", "subjects", "effects", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^event_[a-z0-9_]+$"},
    "timeline_order": {"type": "integer", "minimum": 0},
    "chapter_id": {"type": "string"},
    "type": {"type": "string"},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "effects": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "value"], "properties": {"path": {"type": "string"}, "value": {}}}},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["chapter_id", "locator"], "properties": {"chapter_id": {"type": "string"}, "locator": {"type": "string"}}}}
  }
}
